        "HGGhdKYaDFudOHsxlJUv6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 113803236,
      "version": 5,
      "versionNonce": 1099518692,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782936529208,
      "link": null,
      "locked": false,
      "text": "无缓冲 channel 规则\n\n无缓冲 channel 不经过 buf 存储数据\n发送和接收必须配对\n有接收者时发送方直接拷贝给接收方\n有发送者时接收方直接从发送方 sudog.elem 拷贝",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "LavNFp03Xm5rnLP2Ga92t",
      "originalText": "无缓冲 channel 规则\n\n无缓冲 channel 不经过 buf 存储数据\n发送和接收必须配对\n有接收者时发送方直接拷贝给接收方\n有发送者时接收方直接从发送方 sudog.elem 拷贝",
      "lineHeight": 1.25,
      "index": "b2o",
      "autoResize": true
    },
