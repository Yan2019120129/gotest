      "isDeleted": false,
      "boundElements": [],
      "updated": 1782936529166,
      "link": null,
      "locked": false,
      "text": "是 → 直接把 value\n交给接收 G\n不进 buffer，唤醒接收 G",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "HHMm15sW7GnA6UqTLY6GH",
      "originalText": "是 → 直接把 value\n交给接收 G\n不进 buffer，唤醒接收 G",
      "lineHeight": 1.25,
      "index": "b0w",
      "autoResize": true
    },
