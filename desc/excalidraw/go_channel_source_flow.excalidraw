      "updated": 1782936529135,
      "link": null,
      "locked": false,
      "text": "type hchan struct {\n    qcount   uint           // 队列中已有元素数量\n    dataqsiz uint           // 环形队列容量\n    buf      unsafe.Pointer // 环形队列\n    elemsize uint16\n    closed   uint32\n    timer    *timer\n    elemtype *_type\n    sendx    uint           // 发送写入位置\n    recvx    uint           // 接收读取位置\n    recvq    waitq          // 等待接收的 goroutine 队列\n    sendq    waitq          // 等待发送的 goroutine 队列\n    lock     mutex\n}",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "gsVlRzHdsqy_-Pd4-1nJS",
      "originalText": "type hchan struct {\n    qcount   uint           // 队列中已有元素数量\n    dataqsiz uint           // 环形队列容量\n    buf      unsafe.Pointer // 环形队列\n    elemsize uint16\n    closed   uint32\n    timer    *timer\n    elemtype *_type\n    sendx    uint           // 发送写入位置\n    recvx    uint           // 接收读取位置\n    recvq    waitq          // 等待接收的 goroutine 队列\n    sendq    waitq          // 等待发送的 goroutine 队列\n    lock     mutex\n}",
      "lineHeight": 1.25,
      "index": "aG",
      "autoResize": true
    },
