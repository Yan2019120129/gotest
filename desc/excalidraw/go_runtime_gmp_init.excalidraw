    {
      "id": "FQjckaai-uJH3o1vweRe-",
      "type": "text",
      "x": 3118.9243908867516,
      "y": 938.9831285954685,
      "width": 408.44696044921875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#111",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9n_Wiwyu73zyhTnc3T_qv"
      ],
      "frameId": null,
