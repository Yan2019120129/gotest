      "updated": 1782940195429,
      "link": null,
      "locked": false,
      "text": "Stack Overflow Check\n栈空间不足触发扩容；必要时 Stack\nCopy",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "rectangle_00580",
      "originalText": "Stack Overflow Check\n栈空间不足触发扩容；必要时 Stack Copy",
      "lineHeight": 1.25,
      "baseline": 37,
      "index": "b5u"
    },
