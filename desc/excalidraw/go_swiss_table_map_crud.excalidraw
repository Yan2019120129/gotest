      "versionNonce": 1303023421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783895109297,
      "link": null,
      "locked": false,
      "text": "Before: children[3] → entry{k1,v1}\nInsert: entry{k2,v2}\nAfter: children[3] → indirect\n  children[oldIndex] → entry{k1,v1}\n  children[newIndex] → entry{k2,v2}\nexpand(...)：若当前层仍同 index，\n继续创建更深 indirect，直到 oldIndex != newIndex。",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before: children[3] → entry{k1,v1}\nInsert: entry{k2,v2}\nAfter: children[3] → indirect\n  children[oldIndex] → entry{k1,v1}\n  children[newIndex] → entry{k2,v2}\nexpand(...)：若当前层仍同 index，\n继续创建更深 indirect，直到 oldIndex != newIndex。",
      "autoResize": false,
      "lineHeight": 1.35,
      "index": "b5g"
    },
