      "link": null,
      "locked": false,
      "text": "Before: children[3] → entry{k1,v1}\nInsert: entry{k2,v2}\n且 oldHash == newHash\nAfter: children[3] → entry{k2,v2}\n  overflow → entry{k1,v1}\nnewEntry.overflow.Store(oldEntry)\n返回 &newEntry.node",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before: children[3] → entry{k1,v1}\nInsert: entry{k2,v2}\n且 oldHash == newHash\nAfter: children[3] → entry{k2,v2}\n  overflow → entry{k1,v1}\nnewEntry.overflow.Store(oldEntry)\n返回 &newEntry.node",
      "autoResize": false,
      "lineHeight": 1.35,
      "index": "b5t"
    },
