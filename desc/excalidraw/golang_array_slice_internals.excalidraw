    {
      "id": "t873",
      "type": "text",
      "x": 40,
      "y": 6618,
      "width": 667.8287963867188,
      "height": 60,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
