    {
      "type": "text",
      "angle": 0,
      "id": "text-wk",
      "x": 60,
      "y": 2700,
      "width": 2060,
      "height": 70,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "summary-section-181"
      ],
      "frameId": null,
      "index": "bHv",
      "roundness": null,
      "seed": 9381068,
      "version": 2,
      "versionNonce": 1850743438,
      "isDeleted": false,
      "locked": false,
      "link": null,
      "boundElements": [],
      "autoResize": false,
      "fontFamily": 1,
      "fontSize": 14,
      "lineHeight": 1.15,
      "originalText": "技术要点：白色只是“本轮尚未发现”；灰色表示已发现但引用未扫描完；黑色表示对象及直接引用已扫描完。E → F 不会让两者存活，必须从 Root 可达才保留。Go GC 为非移动式 GC。",
      "text": "技术要点：白色只是“本轮尚未发现”；灰色表示已发现但引用未扫描完；黑色表示对象及直接引用已扫描完。E → F 不会让两者存活，必须从 Root 可达才保留。Go GC 为非移动式 GC。",
      "textAlign": "left",
      "verticalAlign": "middle",
      "updated": 1783938629027,
      "containerId": null
    },
    {
      "type": "text",
      "angle": 0,
      "id": "text-wl",
      "x": 2180,
      "y": 2740,
      "width": 1330,
      "height": 65,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "summary-section-181"
      ],
      "frameId": null,
      "index": "bHw",
      "roundness": null,
      "seed": 9388987,
      "version": 2,
      "versionNonce": 1916738898,
      "isDeleted": false,
      "locked": false,
      "link": null,
      "boundElements": [],
      "autoResize": false,
      "fontFamily": 1,
      "fontSize": 14,
      "lineHeight": 1.15,
      "originalText": "Sweep ≠ Scavenger\nSweep 处理对象槽；Scavenger 处理空闲物理页。\n队列为空还需确认没有其他标记工作。",
      "text": "Sweep ≠ Scavenger\nSweep 处理对象槽；Scavenger 处理空闲物理页。\n队列为空还需确认没有其他标记工作。",
      "textAlign": "left",
      "verticalAlign": "middle",
      "updated": 1783938629027,
      "containerId": null
    },
