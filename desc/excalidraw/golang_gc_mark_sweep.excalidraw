      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sweep-scavenger-compare-180"
      ],
      "frameId": null,
      "index": "bHA",
      "roundness": null,
      "seed": 9008875,
      "version": 2,
      "versionNonce": 2145055570,
      "isDeleted": false,
      "locked": false,
      "link": null,
      "boundElements": [],
      "autoResize": false,
      "fontFamily": 1,
      "fontSize": 13,
      "lineHeight": 1.15,
      "originalText": "不要将单个 Free 对象槽直接画成归还 OS：物理页回收是更高层的后续处理。",
